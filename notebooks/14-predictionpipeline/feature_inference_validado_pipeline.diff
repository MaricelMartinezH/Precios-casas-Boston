+def save_preprocessor(
+    preprocessor: ColumnTransformer,
+    output_dir: Path = OUTPUT_DIR,
+    filename: str = PREPROCESSOR_FILENAME,
+) -> Path:
+    """Persiste el `ColumnTransformer` ya ajustado (`fit`) sobre `x_train`.
+
+    Se guarda por separado de `save_processed_features` (que ya tiene sus
+    propias pruebas unitarias sobre el conjunto exacto de archivos que
+    produce) para no alterar ese contrato. Lo usa `inference_pipeline.py`
+    (Issue: Inference Pipeline) para transformar datos nuevos con
+    `.transform()`, sin volver a ajustar (`fit`) el preprocesador.
+    """
+    output_dir.mkdir(parents=True, exist_ok=True)
+    preprocessor_path = output_dir / filename
+    joblib.dump(preprocessor, preprocessor_path)
+    return preprocessor_path
+
